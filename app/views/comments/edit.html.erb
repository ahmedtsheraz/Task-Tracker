<h1>Edit Comment</h1>

<%= form_with model: [@task, @comment], local: true do |form| %>
  <% if @comment.errors.any? %>
    <div>
      <h2><%= pluralize(@comment.errors.count, "error") %> prevented this comment from being saved:</h2>

      <ul>
        <% @comment.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :body %>
    <%= form.text_area :body %>
  </div>

  <div>
    <%= form.submit "Update Comment" %>
  </div>
<% end %>

<%= link_to "Back to Task", @task %>