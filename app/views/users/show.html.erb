<h1>User Details</h1>

<p>
  <strong>Name:</strong>
  <%= @user.name %>
</p>

<p>
  <strong>Email:</strong>
  <%= @user.email %>
</p>

<p>
  <strong>Tasks:</strong>
  <%= link_to "View all tasks (#{@user.tasks.count})", tasks_user_path(@user) %>
</p>

<p>
  <strong>Comments:</strong>
  <%= @user.comments.count %>
</p>

<%= link_to "Edit", edit_user_path(@user) %> |
<%= link_to "Back to Users", users_path %>

<br><br>

<%= link_to "Delete User", @user, method: :delete,
    data: { confirm: "Are you sure?" } %>