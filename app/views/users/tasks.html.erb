<h1>Tasks for <%= @user.name %></h1>

<%= link_to "Back to User", @user %>

<% if @tasks.any? %>
  <table>
    <thead>
      <tr>
        <th>Title</th>
        <th>Status</th>
        <th>Due Date</th>
        <th>Actions</th>
      </tr>
    </thead>

    <tbody>
      <% @tasks.each do |task| %>
        <tr>
          <td><%= task.title %></td>
          <td><%= task.status %></td>
          <td><%= task.due_date %></td>
          <td><%= link_to "Show", task_path(task) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>This user has no tasks yet.</p>
<% end %>